<?xml version="1.0" encoding="utf-8"?>
<!-- ==========================================================================
     Panda Fit - themes.xml (modo oscuro, BASE API 26)
     Los atributos de API 27+ viven en res/values-night-v27/themes.xml.
     ========================================================================== -->
<resources>
    <style name="Theme.PandaFit" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/panda_ink</item>
        <item name="android:colorBackground">@color/panda_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>
</resources>
